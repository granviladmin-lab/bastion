pkgname=bastion
pkgver=0.1.0
pkgrel=1
pkgdesc='Check Point style viewer for the UFW firewall: rulebase, logs and gateway overview'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'ufw' 'systemd' 'iproute2' 'ttf-jetbrains-mono-nerd')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/bastion "$pkgdir/usr/bin/bastion"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/bastion.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/bastion.svg"
  install -Dm644 "$startdir/bastion.desktop" "$pkgdir/usr/share/applications/bastion.desktop"
}
